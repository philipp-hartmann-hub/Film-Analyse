# ScraperAPI — required on Vercel so Letterboxd/Cloudflare does not block datacenter IPs.
# Locally optional: without it, HTML is fetched directly.
SCRAPER_API_KEY=

# Upstash Redis — optional persistent cache for film details (genres/directors).
# Without these, the app works but re-scrapes every film page.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
